# 服务配置
PORT=8088
HOST=0.0.0.0

# 应用名称（显示在页面标题）
APP_NAME=构建中心

# 应用图标（可以是 URL 或相对路径，留空使用默认 emoji）
# 示例: /assets/logo.png 或 https://example.com/logo.png
# APP_ICON=/path/to/your/icon.png

# 公网访问地址（必须是 HTTPS 才能支持 iOS 安装）
# 留空则自动检测本机内网 IP，如 https://192.168.1.100:8088
# 手动指定示例: https://buildbox.company.com:8088
# PUBLIC_BASE_URL=https://192.168.1.100:8088

# 构建目录（指向 Fastlane 输出的构建产物路径）
# 示例: /path/to/your/fastlane/builds
# BUILDS_DIR=/path/to/builds

# 构建清理策略
MAX_BUILDS=50
MAX_AGE_DAYS=30
DISK_THRESHOLD_GB=50
